{
  "name": "void-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @void-rush/server",
    "dev:client": "npm run dev -w @void-rush/client",
    "build": "npm run build -w @void-rush/client",
    "start": "npm run start -w @void-rush/server",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client",
    "test": "node --test --test-reporter=spec \"packages/shared/test/*.test.ts\" \"apps/server/test/*.test.ts\"",
    "survival": "node packages/shared/scripts/survival.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  }
}
