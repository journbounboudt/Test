# Copy to .env (never commit real values).
NODE_ENV=development
PORT=8787
# Required in production
SESSION_SECRET=
# Telegram bot (enables initData auth + Telegram Stars invoices)
BOT_TOKEN=
BOT_USERNAME=
APP_SHORT_NAME=play
WEBHOOK_SECRET=
PUBLIC_URL=
# Storage
DATA_DIR=./data
# Optional Remote Config override (deep-merged, hot-reloaded)
REMOTE_CONFIG_FILE=./data/remote-config.json
# Dev helpers (ignored in production)
DEV_AUTH=1
PAYMENTS_SANDBOX=1
SEED_DEMO=1
